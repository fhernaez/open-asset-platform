# NEVER use on real installations. For ephemeral CI isolation only.
OAP_ENV=test
OAP_PUBLIC_URL=http://localhost:8088
DJANGO_DEBUG=false
DB_NAME=oap_test
PLUGINS_BOOTSTRAP_MODE=once
PLUGIN_MQTT_DEFAULT_ENABLED=true
TELEMETRY_DEFAULT_STORAGE_MODE=on_change
TELEMETRY_DEFAULT_MAX_SAMPLES=3
TELEMETRY_DEFAULT_WINDOW=PT1H
FEATURE_PHYSICAL_COMMANDS_LOCKED=true
MCP_WRITE_LOCKED=true
