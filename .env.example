# OAP reference defaults — NO secrets in this file. Copy to .env; secrets files outside Git.
# === Application ===
OAP_ENV=development
OAP_NAME=Open Asset Platform
OAP_PUBLIC_URL=http://localhost:8080
OAP_DEFAULT_LOCALE=es
OAP_DEFAULT_TIMEZONE=UTC
OAP_LOG_LEVEL=INFO
OAP_MULTI_TENANT=true
# === Django / security ===
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
DJANGO_SECRET_KEY_FILE=/run/secrets/django_secret
DJANGO_WEB_WORKERS=2
# === Database auto bootstrap ===
DB_HOST=db
DB_PORT=5432
DB_NAME=oap
DB_APP_USER=oap_app
DB_APP_PASSWORD_FILE=/run/secrets/db_app_password
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD_FILE=/run/secrets/db_admin_password
DB_BOOTSTRAP_CREATE_IF_MISSING=true
DB_REQUIRED_EXTENSIONS=postgis,timescaledb
DB_MIGRATE_ON_BOOT=true
# === Auth ===
AUTH_PROVIDER=local
AUTH_OIDC_ISSUER_URL=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET_FILE=
AUTH_BOOTSTRAP_ADMIN_EMAIL=
AUTH_BOOTSTRAP_ADMIN_PASSWORD_FILE=
# === Plugin management ===
PLUGINS_BOOTSTRAP_MODE=once
PLUGINS_ADMIN_TOGGLE_ENABLED=true
PLUGIN_LOCKED_DISABLED=
FEATURE_PHYSICAL_COMMANDS_LOCKED=true
MCP_WRITE_LOCKED=true
# === Core function modules ===
PLUGIN_BMS_DEFAULT_ENABLED=true
PLUGIN_EMS_DEFAULT_ENABLED=true
PLUGIN_CMMS_DEFAULT_ENABLED=true
PLUGIN_INVENTORY_DEFAULT_ENABLED=true
PLUGIN_DASHBOARDS_DEFAULT_ENABLED=true
PLUGIN_ANALYTICS_DEFAULT_ENABLED=true
# === Protocol plugins ===
PLUGIN_MQTT_DEFAULT_ENABLED=true
PLUGIN_MODBUS_DEFAULT_ENABLED=false
PLUGIN_BACNET_DEFAULT_ENABLED=false
PLUGIN_HTTP_DEFAULT_ENABLED=false
PLUGIN_EDGE_DEFAULT_ENABLED=false
PLUGIN_PROTOCOL_EXT_DEFAULT_ENABLED=false
MQTT_BROKER_URL=mqtt://mqtt-broker:1883
MQTT_DEFAULT_TLS_REQUIRED=false
MQTT_CONNECT_TIMEOUT_SECONDS=10
MQTT_MAX_PAYLOAD_BYTES=262144
# === MQTT history sampling defaults (can be overridden per agent and per attribute) ===
TELEMETRY_DEFAULT_STORAGE_MODE=on_change
TELEMETRY_DEFAULT_ABSOLUTE_EPSILON=0
TELEMETRY_DEFAULT_MAX_SAMPLES=60
TELEMETRY_DEFAULT_WINDOW=PT1H
TELEMETRY_DEFAULT_WINDOW_STRATEGY=first
TELEMETRY_RETENTION_DAYS=730
TELEMETRY_MAX_CLOCK_SKEW_SECONDS=300
TELEMETRY_LATE_EVENT_POLICY=reject
TELEMETRY_SPOOL_MAX_MB=256
# === Semantics and maps ===
SEMANTIC_RDF_PROJECTION_ENABLED=true
SEMANTIC_SHACL_VALIDATION_ENABLED=true
SPATIAL_MAP_ENGINE=maplibre
SPATIAL_ALLOW_OFFLINE_MAPS=true
SPATIAL_BASEMAP_URL=
STORAGE_OBJECTS_PATH=/var/lib/oap/objects
STORAGE_MAX_IMAGE_MB=50
# === Integrations optional ===
PLUGIN_NODERED_DEFAULT_ENABLED=false
NODERED_BASE_URL=http://nodered:1880
NODERED_AUTH_SECRET_FILE=
PLUGIN_ERP_DEFAULT_ENABLED=false
ERP_PROVIDER=generic
ERP_BASE_URL=
ERP_API_SECRET_FILE=
# === AI and MCP optional ===
PLUGIN_AI_DEFAULT_ENABLED=false
AI_PROVIDER=ollama
AI_BASE_URL=http://ollama:11434
AI_MODEL=
PLUGIN_MCP_DEFAULT_ENABLED=false
MCP_PUBLIC_URL=http://localhost:8080/mcp
MCP_REQUIRE_AUTH=true
# === Jobs and operations ===
EVENT_WORKER_RETRY_MAX=5
REPORT_MAX_ROWS=100000
OBSERVABILITY_METRICS_ENABLED=true
